# ============================================================================
# GOLD SPECTRA PROSPECTOR — environment configuration
# Copy this file to .env, fill in real values, never commit .env.
# Every value here is read server-side only. Nothing in this file may ever
# be exposed to the browser (no NEXT_PUBLIC_ prefix on secrets).
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database (PostgreSQL with PostGIS extension enabled) -------------------
# e.g. Neon, Supabase, Railway, or self-hosted Postgres with `CREATE EXTENSION postgis;`
DATABASE_URL=postgresql://user:password@host:5432/gold_spectra?schema=public

# --- Satellite / Earth-observation data connectors ---------------------------
# Each connector is optional and independent. If a block is left empty, the
# Data Sources & API Settings admin page will show that connector as
# "Not configured" and the availability engine will skip it — it will NOT be
# faked or substituted silently. See src/lib/connectors/README.md.

# Copernicus Data Space Ecosystem (Sentinel-2 L2A) — https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Sentinel Hub (alternative Sentinel-2 access) — https://www.sentinel-hub.com
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# USGS EarthExplorer / M2M API (Landsat 8/9 Collection 2 L2, ASTER)
USGS_EE_USERNAME=
USGS_EE_TOKEN=

# NASA Earthdata (EMIT, ECOSTRESS, and other NASA missions)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# EnMAP (DLR EOWEB / GST)
ENMAP_API_KEY=

# --- Google Maps URL resolution ----------------------------------------------
# Only needed to resolve *shortened* links (maps.app.goo.gl, goo.gl/maps),
# which return an HTTP redirect that must be followed server-side.
# Full https://www.google.com/maps/... URLs are parsed locally and need no key.
GOOGLE_MAPS_SHORTLINK_RESOLVER_TIMEOUT_MS=5000

# --- Object storage (satellite scenes, generated reports, GIS exports) ------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- Background job queue (async raster / analysis processing) --------------
# Phase 5+: a Redis-backed queue (e.g. BullMQ) so heavy GIS work never runs
# inside a web request. See ARCHITECTURE.md.
REDIS_URL=

# --- Seed script (prisma/seed.ts) --------------------------------------------
# Only used once, to create the first admin account. Change the password
# immediately after first login; this is not read anywhere else.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-immediately
